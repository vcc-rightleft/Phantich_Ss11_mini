        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Use Case Diagram Tổng thể - DentCare System\nleft to right direction\nskinparam packageStyle rectangle\n\nactor \&quot;Bệnh nhân\&quot; as Patient\nactor \&quot;Lễ tân\&quot; as Receptionist\nactor \&quot;Nha sĩ\&quot; as Dentist\nactor \&quot;Quản lý phòng khám\&quot; as Manager\n\n&#39; Quan hệ thừa kế Actor (Nha sĩ và Lễ tân đều là Nhân viên phòng khám)\nactor \&quot;Nhân viên\&quot; as Staff\nReceptionist --|&gt; Staff\nDentist --|&gt; Staff\n\nrectangle \&quot;Hệ thống Quản lý Nha khoa DentCare\&quot; {\n  &#39; Phân hệ Bệnh nhân &amp; Lịch hẹn\n  usecase \&quot;Đăng ký thông tin bệnh nhân\&quot; as UC_RegPatient\n  usecase \&quot;Tra cứu hồ sơ bệnh nhân\&quot; as UC_SearchPatient\n  usecase \&quot;Đặt lịch hẹn khám\&quot; as UC_BookAppt\n  usecase \&quot;Hủy lịch hẹn\&quot; as UC_CancelAppt\n  usecase \&quot;Dời lịch hẹn\&quot; as UC_RescheduleAppt\n  usecase \&quot;Gửi SMS xác nhận\&quot; as UC_SendSMS\n  usecase \&quot;Kiểm tra khung giờ trùng\&quot; as UC_CheckSlot\n\n  &#39; Phân hệ Khám bệnh\n  usecase \&quot;Xem lịch trực / lịch hẹn\&quot; as UC_ViewSchedule\n  usecase \&quot;Khám bệnh &amp; Ghi bệnh án\&quot; as UC_Examine\n  usecase \&quot;Chỉ định dịch vụ điều trị\&quot; as UC_AssignService\n  usecase \&quot;Xem lịch sử điều trị cũ\&quot; as UC_ViewHistory\n\n  &#39; Phân hệ Thanh toán &amp; Dịch vụ\n  usecase \&quot;Lập hóa đơn viện phí\&quot; as UC_CreateInvoice\n  usecase \&quot;Xác nhận thanh toán\&quot; as UC_MakePayment\n  usecase \&quot;In biên lai thanh toán\&quot; as UC_PrintReceipt\n  usecase \&quot;Quản lý danh mục dịch vụ\&quot; as UC_ManageService\n\n  &#39; Phân hệ Báo cáo\n  usecase \&quot;Xem báo cáo doanh thu\&quot; as UC_ViewRevenueReport\n  usecase \&quot;Xem thống kê lượt khám\&quot; as UC_ViewVisitStats\n}\n\n&#39; Liên kết của Bệnh nhân\nPatient --&gt; UC_BookAppt\nPatient --&gt; UC_CancelAppt\n\n&#39; Liên kết của Lễ tân\nReceptionist --&gt; UC_RegPatient\nReceptionist --&gt; UC_SearchPatient\nReceptionist --&gt; UC_BookAppt\nReceptionist --&gt; UC_CancelAppt\nReceptionist --&gt; UC_RescheduleAppt\nReceptionist --&gt; UC_CreateInvoice\nReceptionist --&gt; UC_MakePayment\n\n&#39; Liên kết của Nha sĩ\nDentist --&gt; UC_ViewSchedule\nDentist --&gt; UC_Examine\n\n&#39; Liên kết của Quản lý\nManager --&gt; UC_ManageService\nManager --&gt; UC_ViewRevenueReport\nManager --&gt; UC_ViewVisitStats\nManager --&gt; UC_SearchPatient\n\n&#39; Quan hệ include và extend\nUC_BookAppt ..&gt; UC_CheckSlot : &lt;&lt;include&gt;&gt;\nUC_BookAppt ..&gt; UC_SendSMS : &lt;&lt;extend&gt;&gt;\nUC_Examine ..&gt; UC_AssignService : &lt;&lt;include&gt;&gt;\nUC_Examine ..&gt; UC_ViewHistory : &lt;&lt;extend&gt;&gt;\nUC_MakePayment ..&gt; UC_PrintReceipt : &lt;&lt;extend&gt;&gt;\nUC_CreateInvoice ..&gt; UC_Examine : &lt;&lt;requires&gt;&gt;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="0AtbYlznYaz-P8v3dO_4-278">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
