        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Sequence Diagram - Khám bệnh &amp; Tự động tạo Hóa đơn\nautonumber\nskinparam responseMessageBelowArrow true\n\nactor \&quot;Nha sĩ\&quot; as NS\nparticipant \&quot;:KhamBenhUI\&quot; as UI\nparticipant \&quot;:RecordService\&quot; as RecordSvc\nparticipant \&quot;:InvoiceService\&quot; as InvoiceSvc\ndatabase \&quot;:CSDL\&quot; as DB\n\nNS -&gt; UI : Nhập kết quả khám (trieuChung, chanDoan, keHoach, dsDichVu[])\nactivate UI\n\nopt #LightYellow Có ghi chú đặc biệt / cảnh báo\n    NS -&gt; UI : Nhập trường ghi chú (notes)\nend\n\nUI -&gt; RecordSvc : saveMedicalRecord(appointmentId, symptoms, diagnosis, plan, notes, services[])\nactivate RecordSvc\n\nRecordSvc -&gt; DB : INSERT INTO MedicalRecord (...)\nactivate DB\nDB --&gt; RecordSvc : Lưu thành công (recordId)\ndeactivate DB\n\nRecordSvc -&gt; DB : UPDATE Appointment SET status = &#39;Đã khám&#39; WHERE appointmentId = ?\nactivate DB\nDB --&gt; RecordSvc : Cập nhật lịch hẹn thành công\ndeactivate DB\n\n&#39; Tự động kích hoạt luồng lập hóa đơn\nRecordSvc -&gt; InvoiceSvc : generateInvoiceForRecord(recordId, services[])\nactivate InvoiceSvc\n\nInvoiceSvc -&gt; DB : INSERT INTO Invoice (invoiceId, recordId, totalAmount = 0, paymentStatus = &#39;Chưa thanh toán&#39;)\nactivate DB\nDB --&gt; InvoiceSvc : Tạo vỏ hóa đơn thành công (invoiceId)\ndeactivate DB\n\n&#39; Vòng lặp thêm chi tiết hóa đơn\nloop #LightCyan Duyệt từng dịch vụ được chỉ định trong dsDichVu[]\n    InvoiceSvc -&gt; DB : SELECT unitPrice FROM DentalService WHERE serviceId = ?\n    activate DB\n    DB --&gt; InvoiceSvc : Trả về unitPrice\n    deactivate DB\n    \n    InvoiceSvc -&gt; InvoiceSvc : computeLineTotal(quantity, unitPrice) &#39; Self Message\n    \n    InvoiceSvc -&gt; DB : INSERT INTO InvoiceDetail (invoiceId, serviceId, quantity, lineTotal)\n    activate DB\n    DB --&gt; InvoiceSvc : Lưu chi tiết thành công\n    deactivate DB\nend\n\nInvoiceSvc -&gt; InvoiceSvc : calculateTotalAmount() &#39; Self Message tính tổng tiền hóa đơn\n\nInvoiceSvc -&gt; DB : UPDATE Invoice SET totalAmount = ? WHERE invoiceId = ?\nactivate DB\nDB --&gt; InvoiceSvc : Cập nhật tổng tiền thành công\ndeactivate DB\n\nInvoiceSvc --&gt; RecordSvc : Hoàn tất tạo hóa đơn (invoiceId, totalAmount)\ndeactivate InvoiceSvc\n\nRecordSvc --&gt; UI : return Hoàn tất quá trình khám bệnh &amp; sinh hóa đơn\ndeactivate RecordSvc\n\nUI --&gt; NS : Hiển thị \&quot;Đã lưu hồ sơ khám &amp; chuyển thông tin tới Lễ tân thanh toán\&quot;\ndeactivate UI\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="0AtbYlznYaz-P8v3dO_4-627">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
