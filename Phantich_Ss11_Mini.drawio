        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Class Diagram Tổng thể - DentCare System\nskinparam classAttributeIconSize 0\n\nclass Patient {\n  - patientId: String\n  - fullName: String\n  - phone: String\n  - dateOfBirth: Date\n  - gender: String\n  - address: String\n  - medicalHistory: String\n}\n\nclass Dentist {\n  - dentistId: String\n  - fullName: String\n  - specialization: String\n  - phone: String\n}\n\nclass Appointment {\n  - appointmentId: String\n  - patientId: String\n  - dentistId: String\n  - appointmentDate: Date\n  - timeSlot: String\n  - status: String\n  - reason: String\n}\n\nclass MedicalRecord {\n  - recordId: String\n  - appointmentId: String\n  - symptoms: String\n  - diagnosis: String\n  - treatmentPlan: String\n  - notes: String\n  - createdDate: Date\n}\n\nclass DentalService {\n  - serviceId: String\n  - serviceName: String\n  - unitPrice: Float\n  - description: String\n}\n\nclass Invoice {\n  - invoiceId: String\n  - recordId: String\n  - totalAmount: Float\n  - paymentMethod: String\n  - paymentStatus: String\n  - createdDate: Date\n  + calculateTotal(): Float\n}\n\nclass InvoiceDetail {\n  - invoiceId: String\n  - serviceId: String\n  - quantity: Int\n  - lineTotal: Float\n  + calculateLineTotal(): Float\n}\n\n&#39; Mối quan hệ và Bội số\nPatient \&quot;1\&quot; -- \&quot;0..*\&quot; Appointment : \&quot;đặt &gt;\&quot;\nDentist \&quot;1\&quot; -- \&quot;0..*\&quot; Appointment : \&quot;tiếp nhận &gt;\&quot;\n\nAppointment \&quot;1\&quot; -- \&quot;1\&quot; MedicalRecord : \&quot;sinh ra &gt;\&quot;\n\nMedicalRecord \&quot;1\&quot; -- \&quot;1\&quot; Invoice : \&quot;căn cứ thanh toán &gt;\&quot;\n\n&#39; Hóa đơn và Chi tiết hóa đơn là quan hệ Composition (Xóa Invoice thì xóa Detail)\nInvoice \&quot;1\&quot; *-- \&quot;1..*\&quot; InvoiceDetail : \&quot;bao gồm\&quot;\n\n&#39; Chi tiết hóa đơn liên kết với Dịch vụ nha khoa\nDentalService \&quot;1\&quot; -- \&quot;0..*\&quot; InvoiceDetail : \&quot;được tham chiếu &gt;\&quot;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="0AtbYlznYaz-P8v3dO_4-465">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
