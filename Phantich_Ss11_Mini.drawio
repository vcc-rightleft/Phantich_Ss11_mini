        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Class Diagram - Bệnh nhân, Lịch hẹn và Nha sĩ\nskinparam classAttributeIconSize 0\n\nclass Patient {\n  - patientId: String\n  - fullName: String\n  - phone: String\n  - dateOfBirth: Date\n  - gender: String\n  - address: String\n  - medicalHistory: String\n  + register(): Boolean\n  + updateProfile(): Boolean\n  + viewHistory(): List&lt;MedicalRecord&gt;\n}\n\nclass Dentist {\n  - dentistId: String\n  - fullName: String\n  - specialization: String\n  - phone: String\n  + viewSchedule(date: Date): List&lt;Appointment&gt;\n  + updateWorkSchedule(): void\n}\n\nclass Appointment {\n  - appointmentId: String\n  - patientId: String\n  - dentistId: String\n  - appointmentDate: Date\n  - timeSlot: String\n  - status: String\n  - reason: String\n  + createAppointment(): Boolean\n  + cancelAppointment(): Boolean\n  + reschedule(newDate: Date, newSlot: String): Boolean\n  + checkAvailability(): Boolean\n}\n\n&#39; Thiết lập Association và Multiplicity theo yêu cầu\nPatient \&quot;1\&quot; -- \&quot;0..*\&quot; Appointment : \&quot;đặt lịch &gt;\&quot;\nDentist \&quot;1\&quot; -- \&quot;0..*\&quot; Appointment : \&quot;phụ trách &gt;\&quot;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="0AtbYlznYaz-P8v3dO_4-331">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
