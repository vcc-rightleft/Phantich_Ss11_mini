        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Sequence Diagram - Đặt lịch hẹn (DentCare)\nautonumber\nskinparam responseMessageBelowArrow true\n\nactor \&quot;Bệnh nhân\&quot; as BN\nparticipant \&quot;:DatLichUI\&quot; as UI\nparticipant \&quot;:AppointmentService\&quot; as ApptSvc\nparticipant \&quot;:DentistService\&quot; as DentSvc\ndatabase \&quot;:CSDL\&quot; as DB\n\nBN -&gt; UI : Nhập thông tin đặt lịch (NhaSiID, NgayHen, TimeSlot, LyDo)\nactivate UI\n\nUI -&gt; ApptSvc : bookAppointment(patientId, dentistId, date, slot, reason)\nactivate ApptSvc\n\nApptSvc -&gt; DentSvc : checkDentistAvailability(dentistId, date, slot)\nactivate DentSvc\n\nDentSvc -&gt; DB : SELECT COUNT(*) FROM Appointment WHERE dentistId = ? AND appointmentDate = ? AND timeSlot = ? AND status = &#39;Đã xác nhận&#39;\nactivate DB\nDB --&gt; DentSvc : Trả về số lượng (count)\ndeactivate DB\n\nDentSvc --&gt; ApptSvc : Kết quả khả dụng (isAvailable)\ndeactivate DentSvc\n\nalt #LightGreen isAvailable == true (Còn slot trống)\n    ApptSvc -&gt; DB : INSERT INTO Appointment (appointmentId, patientId, dentistId, appointmentDate, timeSlot, status, reason) VALUES (...)\n    activate DB\n    DB --&gt; ApptSvc : Lưu thành công (appointmentId)\n    deactivate DB\n    ApptSvc --&gt; UI : return Success (Mã lịch hẹn, Trạng thái: Đã xác nhận)\n    UI --&gt; BN : Hiển thị thông báo \&quot;Đặt lịch thành công\&quot;\nelse #LightPink else (Khung giờ đã bị trùng)\n    ApptSvc --&gt; UI : return Error (\&quot;Khung giờ đã có người đặt\&quot;)\n    deactivate ApptSvc\n    UI --&gt; BN : Hiển thị thông báo bận, gợi ý chọn khung giờ khác\nend\ndeactivate UI\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="0AtbYlznYaz-P8v3dO_4-588">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
