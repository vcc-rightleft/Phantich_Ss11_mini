        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Sequence Diagram - Hủy lịch hẹn khám bệnh\nautonumber\nskinparam responseMessageBelowArrow true\n\nactor \&quot;Bệnh nhân\&quot; as BN\nparticipant \&quot;:HuyLichUI\&quot; as UI\nparticipant \&quot;:AppointmentService\&quot; as ApptSvc\ndatabase \&quot;:CSDL\&quot; as DB\nparticipant \&quot;:NotificationService\&quot; as NotifySvc\n\nBN -&gt; UI : Chọn lịch hẹn cần hủy &amp; Bấm \&quot;Yêu cầu hủy\&quot;\nactivate UI\n\nUI -&gt; ApptSvc : cancelAppointment(appointmentId, patientId)\nactivate ApptSvc\n\nApptSvc -&gt; DB : SELECT status, appointmentDate, timeSlot FROM Appointment WHERE appointmentId = ?\nactivate DB\nDB --&gt; ApptSvc : Trả về thông tin lịch hẹn (status)\ndeactivate DB\n\nalt #LightGreen status IN (&#39;Chờ xác nhận&#39;, &#39;Đã xác nhận&#39;)\n    ApptSvc -&gt; DB : UPDATE Appointment SET status = &#39;Đã hủy&#39; WHERE appointmentId = ?\n    activate DB\n    DB --&gt; ApptSvc : Cập nhật trạng thái thành công\n    deactivate DB\n    \n    &#39; Gửi thông điệp bất đồng bộ thông báo tới bệnh nhân và nha sĩ\n    ApptSvc -&gt;&gt; NotifySvc : sendCancellationSMS(patientPhone, dentistPhone, appointmentId)\n    activate NotifySvc\n    note right of NotifySvc : Xử lý gửi tin nhắn SMS chạy ngầm (Asynchronous),\\nkhông chặn luồng người dùng\n    deactivate NotifySvc\n\n    ApptSvc --&gt; UI : return Success (\&quot;Hủy lịch hẹn thành công\&quot;)\n    UI --&gt; BN : Hiển thị màn hình xác nhận đã hủy lịch hẹn\nelse #LightPink else (status == &#39;Đã khám&#39;)\n    ApptSvc --&gt; UI : return Error (\&quot;Lịch hẹn đã hoàn thành khám, không thể hủy!\&quot;)\n    deactivate ApptSvc\n    UI --&gt; BN : Hiển thị thông báo từ chối hủy lịch\nend\ndeactivate UI\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="0AtbYlznYaz-P8v3dO_4-684">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
